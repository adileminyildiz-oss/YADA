# YADA Administration — variables d'environnement (copier en .env, ne JAMAIS committer .env)
NODE_ENV=development
PORT=3000

# Base de données (le SaaS naît sur PostgreSQL — plan L0)
# Rôle applicatif SOUMIS au RLS (pas de superuser).
DATABASE_URL=postgres://yada_app:yada_app_pwd@localhost:5433/yada

# Rôle propriétaire (migrations uniquement).
DATABASE_ADMIN_URL=postgres://yada_owner:yada_owner_pwd@localhost:5433/yada

# Secret JWT — remplacer par une valeur longue et aléatoire en production.
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_EXPIRES_IN=12h
